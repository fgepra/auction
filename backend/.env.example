# (선택) 프론트와 백엔드를 서로 다른 도메인에 배포할 때만
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# (선택) 리버스 프록시 뒤에서 실행할 때
# TRUST_PROXY=1
# (선택) 마감된 경매를 정리하는 주기(ms)
# CLOSER_INTERVAL_MS=5000
