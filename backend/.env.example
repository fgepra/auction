# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (Windows: copy .env.example .env)

# 서버
PORT=4000
# 프론트엔드 주소 (쉼표로 여러 개 가능). CORS와 출처 검사에 쓰입니다.
CLIENT_ORIGIN=http://localhost:3000

# 로그인 토큰 서명용 비밀 문자열. 길고 무작위로 정하세요. (운영에서는 32자 이상 필수)
# 만드는 법: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=000f3f3d7f8bff5a9d1e001ec7abe82bd105f8345127fa93e6a5285aa9bcd71cdfa860625e7a2c19781a233f24c7b381

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=0000

DB_NAME=imaginati                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               